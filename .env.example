APP_ENV=development
# Optional only in local mock mode. Required (24+ characters) in real/production mode.
APP_API_KEY=
MOCK_MODE=true
GNANI_API_KEY=
PRISMA_ENABLED=true
TIMBRE_ENABLED=true
TIMBRE_MODEL=timbre-v2.5
EVON_BASE_URL=http://127.0.0.1:8080/v1
EVON_API_KEY=
EVON_MODEL=evon
EVON_TIMEOUT_SECONDS=120
EVON_MAX_CONCURRENT=1
EVON_QUEUE_SIZE=4
EVON_QUEUE_TIMEOUT_SECONDS=5
EVON_CONTEXT_TOKENS=512
TRANSLATION_PROVIDER=identity
TRANSLATE_HINDI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
PROVIDER_TIMEOUT_SECONDS=60
MAX_AUDIO_MB=15
MAX_AUDIO_SECONDS=60
MAX_TRANSCRIPT_CHARS=3000
REPORT_TTL_SECONDS=1800
MAX_REPORTS=500
MAX_CACHED_AUDIO_MB=32
WARNING_AUDIO_TTL_SECONDS=3600
REQUESTS_PER_MINUTE=60
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# v2 live risk assessment. Real use needs a larger shared Evon context (e.g. 4096).
LIVE_ENABLED=true
LIVE_MAX_SESSIONS=10
LIVE_SESSION_SECONDS=900
LIVE_MAX_TURNS=200
LIVE_HISTORY_SIZE=100
LIVE_CHECKPOINT_SECONDS=1
LIVE_STT_MAX_SPEECH_SECONDS=5
LIVE_EVENT_QUEUE_SIZE=64
RISK_MAX_TOKENS=256
